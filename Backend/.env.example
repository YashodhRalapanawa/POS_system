PORT=3000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only. Needed for username sign-in, staff account creation, failed sign-in
# logging and revoking sessions on logout. Never put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Frontend origin, used for CORS and the links in confirmation emails.
FRONTEND_URL=http://localhost:5173
# Page the password-reset email links to (defaults to FRONTEND_URL/login).
PASSWORD_RESET_REDIRECT_URL=
# Chatbot assistant (Groq). Server-side only; never put this key in the frontend.
GROQ_API_KEY=
# Must be a Groq model that supports tool use.
GROQ_MODEL=openai/gpt-oss-120b
CHAT_RATE_LIMIT_PER_MINUTE=15
